CONFIG_FREERTOS_HZ=1000
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# Ohne diese zwei Zeilen übersetzt ssl_client.cpp des Arduino-Kerns leer und das Linken scheitert (WiFiClientSecure).
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y
# Version im App-Deskriptor: muss CAM_FW_VERSION in src/cam_config.h entsprechen (ota-publish prüft das und liest sie ins Manifest)
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="0.1.7"
# Gesichtsmodell espdet_pico_224 (CAM_FACE_MODEL 1 in cam_config.h) zusätzlich zu MSR+MNP ins Flash; Vorgabe ist das Pico-Modell.
CONFIG_FLASH_ESPDET_PICO_224_224_FACE=y
CONFIG_ESPDET_PICO_224_224_FACE=y
# Geschwindigkeit: CPU 240 MHz, Code mit -O2, PSRAM mit 80 MHz, grosser Daten-Cache (64 KB, 64-Byte-Zeilen)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# Task-Watchdog: Hängt loop() (Kamera, Erkennung), setzt der XIAO sich nach 30 s zurück. Leerlauf-Tasks nicht prüfen.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0 is not set
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1 is not set
